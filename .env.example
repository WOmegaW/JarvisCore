# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID группы (или нескольких через запятую), в которой работает бот.
# Узнать: добавьте бота в группу и напишите /id. Пусто = бот работает в любом чате.
ALLOWED_CHAT_IDS=

# Часовой пояс магазина
TZ=Europe/Moscow

# Во сколько присылать утренние оповещения (ЧЧ:ММ)
NOTIFY_TIME=09:00

# За сколько дней до окончания срока ставить скидку
DISCOUNT_DAYS_BEFORE=2

# Размер скидки, %
DISCOUNT_PERCENT=50

# Путь к базе данных
DB_PATH=data/expiry.db
